{
  "name": "stock-sim-terminal",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonmmcoset/StockSim.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "cd server && go run ./cmd/stocksim",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:server": "cd server && go build -o ../bin/stocksim ./cmd/stocksim",
    "start": "npm run build && npm run build:server && cd server && ../bin/stocksim",
    "test:server": "cd server && go test ./...",
    "test:race": "cd server && go test -race ./...",
    "test:integration": "npm run build && npm run build:server && node scripts/check-multiplayer.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.8"
  }
}
